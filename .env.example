# env.example as dev
NODE_ENV=development

# Directory containing MP3 files
AMBIANCE_FOLDER=/path/to/mp3

# AcoustID API key (OPTIONAL - disabled by default)
# Only needed for audio fingerprinting of files without ID3 tags
# Requires: brew install chromaprint
# Note: May cause SIGSEGV crashes on some systems
# Rate limiting: 1 request per minute enforced by the app
# Get free API key: https://acoustid.org/api-key
#ACOUSTID_KEY=your_acoustid_api_key_here
